[Unit]
Description=Rclone Mount Google Drive DonNTU
# Wait for full working network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set priotiy for smooth start
Nice=15
IOSchedulingClass=idle
# Create dir if not exist
ExecStartPre=/usr/bin/mkdir -p %h/mnt/GDriveDonNTU
# ExecStartPre=/usr/bin/mkdir -p %h/mnt/ODrivePersonalDonNTU
# Mount and sync Google Drive (DonNTU) by rclone
ExecStart=/usr/bin/rclone mount gdrive-donntu: %h/mnt/GDriveDonNTU \
    --config %h/.config/rclone/rclone.conf \
    --allow-other \
    --vfs-cache-mode writes \
    --vfs-cache-max-size 500M \
    --buffer-size 16M \
    --dir-cache-time 5m \
    --vfs-cache-max-age 1h \
    --attr-timeout 1s \
    --no-modtime \
    --vfs-fast-fingerprint \
    --log-level NOTICE
# Unmount Google Drive if error
ExecStop=/bin/fusermount -u %h/mnt/google
# Selfhealing parameters
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=default.target
